---
import Layout from "../layouts/Layout.astro";
import DoctorCard from "../components/DoctorCard.astro";
import CTASection from "../components/CTASection.astro";
import { DOCTORS, SITE } from "../lib/site";
---

<Layout
  title={`Our Team | ${SITE.name}`}
  description="Meet the physicians and nurse practitioners at Meridian Family Health, a small team that knows every patient by name."
>
  <section class="border-b border-ink/10 bg-paper" data-meridian="Team">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.05] text-ink text-balance sm:text-6xl">
        A small team, on purpose.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        Our patient panels are smaller than most practices, so every doctor has time to know you. Here is who you will see.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8" data-meridian="Doctors">
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {DOCTORS.map((doctor) => (
        <DoctorCard
          name={doctor.name}
          role={doctor.role}
          bio={doctor.bio}
          education={doctor.education}
          image={doctor.image as any}
        />
      ))}
    </div>
  </section>

  <CTASection
    title="Choose your doctor"
    description="Pick a provider when you book, or let us match you with the first available."
  />
</Layout>
