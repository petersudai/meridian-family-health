---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTASection from "../components/CTASection.astro";
import { img, IMAGES } from "../lib/images";
import { SITE } from "../lib/site";
---

<Layout
  title={`About Us | ${SITE.name}`}
  description="The story behind Meridian Family Health, and why we built a practice around continuity of care instead of rushed appointments."
>
  <section class="border-b border-ink/10 bg-paper" data-meridian="About">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.05] text-ink text-balance sm:text-6xl">
        Built by doctors who were tired of ten-minute appointments.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        The practice started with one rule: schedule enough time to listen.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8" data-meridian="Story">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div class="duotone aspect-[4/5]" data-reveal>
        <img
          src={img(IMAGES.teamMeeting, 1200)}
          alt="The Meridian care team reviewing patient care plans together"
          class="h-full w-full object-cover"
        />
      </div>
      <div data-reveal>
        <SectionHeading title="Founded on continuity, not throughput" />
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-soft">
          <p>
            In 2008, Dr. Amara Whitfield left a large hospital system frustrated by a schedule that gave her eleven
            minutes per patient. She opened Meridian with two exam rooms and one rule: every patient gets known.
          </p>
          <p>
            Eighteen years later the practice has grown into a team of physicians and nurse practitioners, and the
            model is the same. Patient panels stay small and appointments stay long, and your doctor reads your chart
            before you sit down.
          </p>
          <p>
            Today Meridian cares for more than 12,000 patients, many of them across three generations of the same
            family. Appointments are available within the week, prices are quoted in advance, and video visits cover
            anything that does not need an exam table.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper-warm py-20 sm:py-24" data-meridian="Rooms">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div data-reveal>
        <SectionHeading title="Inside the practice" />
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        <div class="duotone aspect-[16/10] sm:col-span-2 sm:row-span-2 sm:aspect-auto">
          <img src={img(IMAGES.clinicInterior, 1200)} alt="The waiting area at Meridian Family Health" class="h-full w-full object-cover" />
        </div>
        <div class="duotone aspect-square">
          <img src={img(IMAGES.reception, 700)} alt="The reception desk" class="h-full w-full object-cover" />
        </div>
        <div class="duotone aspect-square">
          <img src={img(IMAGES.waitingRoom, 700)} alt="Seating in the patient waiting room" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Meet the doctor you will keep seeing"
    description="Book a first visit. The doctor you meet is the one you will see next time."
  />
</Layout>
