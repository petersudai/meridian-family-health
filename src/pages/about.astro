---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon";
import { img, IMAGES } from "../lib/images";
import { SITE } from "../lib/site";
---

<Layout
  title={`About Us | ${SITE.name}`}
  description="Learn the story behind Meridian Family Health, our mission, and why we built a practice around continuity of care instead of rushed appointments."
>
  <!-- Page hero -->
  <section class="bg-forest-light/60">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-terracotta">About {SITE.shortName}</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold text-ink text-balance sm:text-5xl">
        Built by doctors who were tired of ten-minute appointments.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Meridian Family Health started with a simple idea: patients deserve doctors who have time to actually
        listen.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div class="overflow-hidden rounded-[2rem]">
        <img
          src={img(IMAGES.teamMeeting, 1200)}
          alt="Meridian Family Health care team meeting to review patient care plans"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div>
        <SectionHeading eyebrow="Our story" title="Founded on continuity, not throughput" />
        <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-soft">
          <p>
            In 2008, Dr. Amara Whitfield left a large hospital system frustrated by a schedule that gave her
            eleven minutes per patient. She opened Meridian with two exam rooms and a promise: every patient
            would be known, not just processed.
          </p>
          <p>
            Eighteen years later, that promise has scaled to a full team of physicians and nurse practitioners,
            but the model has not changed. Smaller patient panels. Longer appointments. Doctors who read your
            chart before you sit down, not while you are talking.
          </p>
          <p>
            Today, Meridian cares for more than 12,000 patients across three generations of the same families,
            with same-week scheduling, transparent pricing, and a telehealth option for the visits that do not
            need an exam table.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="bg-forest-dark py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <Icon name="sparkles" className="mx-auto h-8 w-8 text-terracotta" />
      <h2 class="mt-5 font-display text-3xl font-semibold text-white text-balance sm:text-4xl">
        Our mission is simple: give every patient the appointment they deserve.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-cream/70">
        Unhurried. Well-informed. Priced honestly. We measure success by how well we know our patients, not by
        how many we can see in a day.
      </p>
    </div>
  </section>

  <!-- Facility -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <SectionHeading eyebrow="Our facility" title="A calmer place to see a doctor" align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="overflow-hidden rounded-3xl sm:col-span-2 sm:row-span-2">
        <img
          src={img(IMAGES.clinicInterior, 1200)}
          alt="Bright, modern waiting area at Meridian Family Health"
          class="aspect-[16/10] w-full object-cover sm:aspect-square"
        />
      </div>
      <div class="overflow-hidden rounded-3xl">
        <img src={img(IMAGES.reception, 700)} alt="Reception desk at Meridian Family Health" class="aspect-square w-full object-cover" />
      </div>
      <div class="overflow-hidden rounded-3xl">
        <img src={img(IMAGES.waitingRoom, 700)} alt="Comfortable seating in the patient waiting room" class="aspect-square w-full object-cover" />
      </div>
    </div>
  </section>

  <CTASection
    title="Come see the difference for yourself"
    description="Book a first visit and meet the doctor who will actually remember your name next time."
  />
</Layout>
