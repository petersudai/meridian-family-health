---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon";
import BookingWidget from "../components/BookingWidget";
import { img, IMAGES } from "../lib/images";
import { SERVICES, SITE } from "../lib/site";

const SERVICE_IMAGES: Record<string, keyof typeof IMAGES> = {
  "primary-care": "heroConsultAlt",
  "pediatric-care": "pediatricVisit",
  "womens-health": "familyOutdoors",
  "chronic-care": "clinicInteriorAlt",
  "urgent-visits": "waitingRoom",
  telehealth: "telehealth",
};
---

<Layout
  title={`Services | ${SITE.name}`}
  description="Explore primary care, pediatric care, women's health, chronic condition management, urgent visits, and telehealth at Meridian Family Health."
>
  <!-- Page hero -->
  <section class="bg-paper bg-chart-grid-light" data-meridian="Services">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8" data-reveal>
      <p class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-gold-dark">
        <span class="h-px w-4 bg-current"></span>
        Services
      </p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl font-extrabold text-ink text-balance sm:text-5xl">
        Care for every stage of life, under one roof.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Six core services, one small team of physicians who coordinate your care instead of leaving it to
        chance.
      </p>
    </div>
  </section>

  <!-- Service detail list -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="divide-y divide-ink/10">
      {SERVICES.map((service, i) => (
        <div id={service.slug} data-meridian={service.name} class="grid scroll-mt-28 gap-10 py-16 first:pt-0 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div class:list={[i % 2 === 1 && "lg:order-2"]} data-reveal>
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-ink/35">{String(i + 1).padStart(2, "0")}</span>
              <span class="flex h-11 w-11 items-center justify-center bg-ink text-gold">
                <Icon name={service.icon as any} className="h-5 w-5" />
              </span>
            </div>
            <h2 class="mt-5 font-display text-2xl font-extrabold text-ink sm:text-3xl">{service.name}</h2>
            <p class="mt-4 text-base leading-relaxed text-ink-soft">{service.detail}</p>
            <div class="mt-6">
              <BookingWidget client:load label={`Book ${service.name}`} initialServiceSlug={service.slug} />
            </div>
          </div>
          <div class:list={["duotone aspect-[4/3]", i % 2 === 1 && "lg:order-1"]} data-reveal>
            <img
              src={img(IMAGES[SERVICE_IMAGES[service.slug]], 1100)}
              alt={service.name}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</Layout>
