---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import BookingWidget from "../components/BookingWidget";
import { img, IMAGES } from "../lib/images";
import { SERVICES, SITE } from "../lib/site";

const SERVICE_IMAGES: Record<string, keyof typeof IMAGES> = {
  "primary-care": "heroConsultAlt",
  "pediatric-care": "pediatricVisit",
  "womens-health": "familyOutdoors",
  "chronic-care": "clinicInteriorAlt",
  "urgent-visits": "waitingRoom",
  telehealth: "telehealth",
};
---

<Layout
  title={`Services | ${SITE.name}`}
  description="Primary care, pediatric care, women's health, chronic condition management, urgent visits and telehealth at Meridian Family Health."
>
  <section class="border-b border-ink/10 bg-paper" data-meridian="Services">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.05] text-ink text-balance sm:text-6xl">
        Care for every stage of life, under one roof.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        Six kinds of visit, one small team that shares your chart.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
    <div class="divide-y divide-ink/15">
      {SERVICES.map((service, i) => (
        <div id={service.slug} data-meridian={service.short} class="grid scroll-mt-24 gap-10 py-14 first:pt-0 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div class:list={[i % 2 === 1 && "lg:order-2"]} data-reveal>
            <h2 class="font-display text-3xl font-extrabold text-ink">{service.name}</h2>
            <p class="mt-4 max-w-lg text-lg leading-relaxed text-ink-soft">{service.detail}</p>
            <div class="mt-7">
              <BookingWidget client:load label="Book this visit" initialServiceSlug={service.slug} />
            </div>
          </div>
          <div class:list={["duotone aspect-[4/3]", i % 2 === 1 && "lg:order-1"]} data-reveal>
            <img
              src={img(IMAGES[SERVICE_IMAGES[service.slug]], 1100)}
              alt={service.name}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</Layout>
