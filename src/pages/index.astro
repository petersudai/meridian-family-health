---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import BookingWidget from "../components/BookingWidget";
import Icon from "../components/Icon";
import { img, IMAGES } from "../lib/images";
import { SERVICES, STATS, DOCTORS, TESTIMONIALS, VALUES, SITE } from "../lib/site";

const leadDoctor = DOCTORS[0];
---

<Layout
  title={`${SITE.name} | Modern Family Medicine, Without the Wait`}
  description="Meridian Family Health offers same-week appointments, whole-family primary care, and doctors who know your name. Book your visit online today."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-cream">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8 lg:py-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-forest-light px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-forest">
          <Icon name="shieldcheck" className="h-3.5 w-3.5" />
          Accepting new patients
        </p>
        <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.1] text-ink text-balance sm:text-5xl lg:text-6xl">
          Family medicine, done with care and without the wait.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          {SITE.name} brings modern, whole-person primary care to every stage of life, from first checkups to
          golden years, with same-week appointments and doctors who actually remember your name.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <BookingWidget client:load label="Book an Appointment" />
          <a
            href="/team"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-ink/15 px-6 py-3 text-sm font-semibold text-ink transition hover:border-forest hover:text-forest"
          >
            Meet our doctors
          </a>
        </div>
        <div class="mt-10 flex items-center gap-6 text-sm text-ink-soft">
          <div class="flex items-center gap-1.5">
            <div class="flex text-terracotta">
              {Array.from({ length: 5 }).map(() => <Icon name="star" className="h-4 w-4 fill-current" />)}
            </div>
            <span class="font-semibold text-ink">4.9/5</span>
          </div>
          <span class="text-ink-soft/50">|</span>
          <span>12,400+ patients cared for since 2008</span>
        </div>
      </div>

      <div class="relative">
        <div class="aspect-[4/5] overflow-hidden rounded-[2.5rem] shadow-2xl shadow-forest/10">
          <img
            src={img(IMAGES.heroPortrait, 1400)}
            alt="Physician in a mask and white coat at Meridian Family Health"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 hidden max-w-[13rem] rounded-2xl bg-paper p-5 shadow-xl sm:block">
          <div class="flex items-center gap-2 text-forest">
            <Icon name="clock" className="h-5 w-5" />
            <span class="text-sm font-semibold text-ink">Same-week visits</span>
          </div>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-soft">Most appointments confirmed within 48 hours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-ink/8 bg-paper">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-6 py-12 sm:grid-cols-4 lg:px-8">
      {STATS.map((stat) => (
        <div class="text-center">
          <p class="font-display text-3xl font-semibold text-forest sm:text-4xl">{stat.value}</p>
          <p class="mt-1.5 text-xs font-medium uppercase tracking-wide text-ink-soft sm:text-sm">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="What we treat"
        title="Care for every member of the family"
        description="From newborn checkups to chronic condition management, our physicians cover the visits that matter most, in one place."
      />
      <a href="/services" class="hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-forest sm:inline-flex">
        View all services
        <Icon name="arrowright" className="h-4 w-4" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service) => (
        <ServiceCard name={service.name} summary={service.summary} icon={service.icon as any} href={`/services#${service.slug}`} />
      ))}
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-forest-light/60 py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8">
      <div class="order-2 grid gap-6 sm:grid-cols-2 lg:order-1">
        {VALUES.map((value) => (
          <div class="rounded-2xl bg-paper p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest text-white">
              <Icon name={value.icon as any} className="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold text-ink">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{value.description}</p>
          </div>
        ))}
      </div>
      <div class="order-1 lg:order-2">
        <SectionHeading
          eyebrow="Why patients switch to us"
          title="Healthcare that treats you like a person, not an appointment slot"
          description="We built Meridian around the things patients told us were missing everywhere else: time, continuity, and honesty about cost."
        />
        <a
          href="/about"
          class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-forest"
        >
          Learn about our approach
          <Icon name="arrowright" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Doctor highlight -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="grid gap-12 rounded-[2.5rem] bg-forest-dark p-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16 lg:p-16">
      <div class="overflow-hidden rounded-3xl">
        <img
          src={img(IMAGES[leadDoctor.image as keyof typeof IMAGES], 900)}
          alt={leadDoctor.name}
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div>
        <Icon name="quote" className="h-9 w-9 text-terracotta/50" />
        <p class="mt-4 font-display text-2xl leading-snug text-white text-balance sm:text-3xl">
          "Our job is not just to treat what's wrong. It's to know you well enough to catch it before it becomes wrong."
        </p>
        <div class="mt-6">
          <p class="font-semibold text-white">{leadDoctor.name}</p>
          <p class="text-sm text-cream/60">{leadDoctor.role} · {SITE.name}</p>
        </div>
        <a href="/team" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-white">
          Meet the full care team
          <Icon name="arrowright" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-paper py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <SectionHeading
        eyebrow="Patient stories"
        title="Trusted by families across the community"
        align="center"
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {TESTIMONIALS.slice(0, 3).map((t) => (
          <TestimonialCard name={t.name} context={t.context} quote={t.quote} avatar={t.avatar as any} rating={t.rating} />
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/reviews" class="inline-flex items-center gap-2 text-sm font-semibold text-forest">
          Read more patient reviews
          <Icon name="arrowright" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
