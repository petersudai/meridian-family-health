---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import BookingWidget from "../components/BookingWidget";
import Icon from "../components/Icon";
import { img, IMAGES } from "../lib/images";
import { SERVICES, DOCTORS, TESTIMONIALS, VALUES, FIRST_VISIT, SITE } from "../lib/site";

const leadDoctor = DOCTORS[0];
---

<Layout
  title={`${SITE.name} | Family Medicine in Cedar Falls`}
  description="Meridian Family Health offers same-week appointments, whole-family primary care and doctors who know your name. Book your visit online."
>
  <!-- Hero -->
  <section class="bg-paper" data-meridian="Home">
    <div class="mx-auto grid max-w-7xl gap-x-12 gap-y-12 px-6 pt-12 sm:pt-16 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:pt-20">
      <div>
        <h1 class="font-display text-[13vw] font-extrabold leading-[1.08] tracking-tight text-ink text-balance sm:text-6xl sm:leading-[1] lg:text-[4.6rem]">
          Family medicine, calibrated to a lifetime.
        </h1>
        <p class="mt-7 max-w-lg text-lg leading-relaxed text-ink-soft">
          Primary care for the whole family in Cedar Falls. Most patients are seen within 48 hours, and you see the
          same small team of doctors every visit.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <BookingWidget client:load label="Book an appointment" />
          <a href="/team" class="btn btn-secondary">Meet our doctors</a>
        </div>
        <a href="/reviews" class="link mt-6">
          Rated 4.9 out of 5 by patients
          <Icon className="h-4 w-4" />
        </a>
      </div>

      <div class="duotone aspect-[4/5]">
        <img
          src={img(IMAGES.heroPortrait, 1400)}
          alt="A physician in a surgical cap and mask looking down at work"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <dl class="mt-14 grid gap-x-8 gap-y-5 border-t border-ink/20 py-7 sm:grid-cols-3">
        <div>
          <dt class="text-sm font-semibold text-ink-soft">Hours</dt>
          <dd class="mt-1 text-ink">Monday to Friday, 8 AM to 6 PM<br />Saturday, 9 AM to 1 PM</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-ink-soft">Call the front desk</dt>
          <dd class="mt-1"><a href={SITE.phoneHref} class="inline-block py-1 font-semibold text-ink hover:underline">{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-ink-soft">Visit</dt>
          <dd class="mt-1 text-ink">{SITE.address.line1}<br />{SITE.address.line2}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-paper-warm py-20 sm:py-24" data-meridian="Services">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div data-reveal>
        <SectionHeading
          title="Six kinds of visit, one care team"
          description="From newborn checkups to long-term conditions, one practice handles it and your records stay in one place."
        />
      </div>

      <ul class="mt-12 grid border-t border-ink/25 md:grid-cols-2 md:gap-x-16" data-reveal>
        {SERVICES.map((service) => (
          <li class="border-b border-ink/15">
            <a href={`/services#${service.slug}`} class="group flex items-start justify-between gap-6 py-6">
              <span>
                <span class="block font-display text-xl font-bold text-ink group-hover:underline">{service.name}</span>
                <span class="mt-1.5 block max-w-md text-ink-soft">{service.summary}</span>
              </span>
              <Icon className="mt-1.5 h-5 w-5 flex-shrink-0 text-ink transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Approach -->
  <section class="bg-paper py-20 sm:py-24" data-meridian="Approach">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1fr_1.2fr] lg:gap-20 lg:px-8">
      <div data-reveal>
        <SectionHeading
          title="A practice built around time, continuity and honest costs"
          description="We built Meridian around three things: enough time, the same doctor, and a price you know in advance."
        />
        <a href="/about" class="link mt-6">
          How the practice works
          <Icon className="h-4 w-4" />
        </a>
      </div>
      <dl class="grid border-t border-ink/25 sm:grid-cols-2 sm:gap-x-10" data-reveal>
        {VALUES.map((value) => (
          <div class="border-b border-ink/15 py-6">
            <dt class="font-display text-lg font-bold text-ink">{value.title}</dt>
            <dd class="mt-1.5 text-ink-soft">{value.description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Doctor -->
  <section class="bg-night py-20 sm:py-24" data-meridian="Care team" data-tone="dark">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16 lg:px-8">
      <div class="duotone aspect-[4/5]" data-reveal>
        <img src={img(IMAGES[leadDoctor.image as keyof typeof IMAGES], 900)} alt={leadDoctor.name} class="h-full w-full object-cover" />
      </div>
      <div data-reveal>
        <blockquote class="font-display text-3xl font-bold leading-snug text-paper text-balance sm:text-4xl">
          &ldquo;I want to know you well enough to notice when something changes, long before it becomes a problem.&rdquo;
        </blockquote>
        <p class="mt-6 font-semibold text-paper">{leadDoctor.name}</p>
        <p class="text-paper/75">{leadDoctor.role}</p>
        <a href="/team" class="btn btn-secondary-dark mt-8">Meet the care team</a>
      </div>
    </div>
  </section>

  <!-- First visit -->
  <section class="bg-paper-warm py-20 sm:py-24" data-meridian="Visit">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.2fr_1fr] lg:gap-20 lg:px-8">
      <div data-reveal>
        <SectionHeading title="What to expect at your first visit" />
        <ol class="mt-10 border-t border-ink/25">
          {FIRST_VISIT.map((step, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-ink/15 py-6">
              <span class="font-display text-3xl font-extrabold leading-none text-ink">{i + 1}</span>
              <div>
                <h3 class="font-display text-lg font-bold text-ink">{step.title}</h3>
                <p class="mt-1 text-ink-soft">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="self-start border border-ink/25 bg-white p-7" data-reveal>
        <h3 class="font-display text-lg font-bold text-ink">Find us</h3>
        <address class="mt-3 text-ink not-italic">{SITE.address.line1}<br />{SITE.address.line2}</address>
        <p class="mt-4"><a href={SITE.phoneHref} class="inline-block py-1 font-semibold text-ink hover:underline">{SITE.phone}</a></p>
        <ul class="mt-5 space-y-2 border-t border-ink/15 pt-5">
          {SITE.hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span class="text-ink-soft">{h.day}</span>
              <span class="text-right text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-paper py-20 sm:py-24" data-meridian="Reviews">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div data-reveal>
        <SectionHeading title="What patients say" />
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {TESTIMONIALS.slice(0, 3).map((t) => (
          <TestimonialCard name={t.name} context={t.context} quote={t.quote} avatar={t.avatar as any} rating={t.rating} />
        ))}
      </div>
      <a href="/reviews" class="link mt-10">
        Read more patient reviews
        <Icon className="h-4 w-4" />
      </a>
    </div>
  </section>

  <CTASection />
</Layout>
