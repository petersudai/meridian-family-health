---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import BookingWidget from "../components/BookingWidget";
import Icon from "../components/Icon";
import { img, IMAGES } from "../lib/images";
import { SERVICES, STATS, DOCTORS, TESTIMONIALS, VALUES, SITE } from "../lib/site";

const leadDoctor = DOCTORS[0];
const ticker = [
  "12,400+ PATIENTS CARED FOR",
  "18 YEARS SERVING CEDAR FALLS",
  "SAME-WEEK APPOINTMENTS",
  "4.9 / 5 AVERAGE RATING",
  "TRANSPARENT PRICING, NO SURPRISES",
];
---

<Layout
  title={`${SITE.name} | Modern Family Medicine, Without the Wait`}
  description="Meridian Family Health offers same-week appointments, whole-family primary care, and doctors who know your name. Book your visit online today."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-paper bg-chart-grid-light" data-meridian="Home">
    <div class="mx-auto grid max-w-7xl gap-x-10 gap-y-14 px-6 pt-14 sm:pt-20 lg:grid-cols-[1.15fr_1fr] lg:items-start lg:gap-16 lg:px-8 lg:pb-8 lg:pt-24">
      <div data-reveal>
        <p class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-gold-dark">
          <span class="h-px w-4 bg-current"></span>
          Est. 2008 &mdash; Cedar Falls
        </p>
        <h1 class="mt-6 font-display text-[13vw] font-extrabold leading-[0.95] tracking-tight text-ink text-balance sm:text-6xl lg:text-[4.6rem]">
          Family medicine, <span class="text-gold-dark">calibrated</span> to a lifetime.
        </h1>
        <p class="mt-7 max-w-lg text-lg leading-relaxed text-ink-soft">
          {SITE.name} brings modern, whole-person primary care to every stage of life, from first checkups to
          golden years, with same-week appointments and doctors who actually remember your name.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <BookingWidget client:load label="Book an Appointment" />
          <a
            href="/team"
            class="inline-flex items-center justify-center gap-2 border border-ink/20 px-6 py-3 font-mono text-xs uppercase tracking-[0.12em] text-ink transition hover:border-ink"
          >
            Meet our doctors
          </a>
        </div>
        <div class="mt-10 flex items-center gap-4 border-t border-ink/10 pt-6 text-sm text-ink-soft">
          <span class="flex items-center gap-1.5 font-mono text-ink">
            <Icon name="star" className="h-4 w-4 fill-current text-gold" />
            4.9
          </span>
          <span class="h-4 w-px bg-ink/15"></span>
          <span class="font-mono text-xs uppercase tracking-wide">12,400+ patients since 2008</span>
        </div>
      </div>

      <div class="relative" data-reveal>
        <div class="duotone aspect-[4/5]">
          <img
            src={img(IMAGES.heroPortrait, 1400)}
            alt="Physician in a mask and white coat at Meridian Family Health"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="absolute bottom-0 left-0 flex items-center gap-2 bg-ink px-3 py-2">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-paper/80">On call &mdash; Exam Room 2</span>
        </div>
      </div>
    </div>

    <div class="mt-14 border-y border-ink/10 bg-ink py-3.5 lg:mt-8">
      <div class="flex overflow-hidden">
        <div class="flex flex-none animate-marquee items-center gap-10 whitespace-nowrap pr-10">
          {[...ticker, ...ticker].map((item) => (
            <span class="flex items-center gap-10 font-mono text-[11px] uppercase tracking-[0.16em] text-paper/70">
              {item}
              <span class="text-gold">&bull;</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="bg-night bg-chart-grid" data-meridian="Numbers">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-night-line px-6 sm:grid-cols-4 sm:divide-y-0 lg:px-8" data-reveal-group>
      {STATS.map((stat) => (
        <div class="px-2 py-12 text-center sm:px-4">
          <p class="font-display text-4xl font-extrabold text-gold sm:text-5xl">{stat.value}</p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.12em] text-paper/55">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8" data-meridian="Services">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="What we treat"
        title="Care for every member of the family"
        description="From newborn checkups to chronic condition management, our physicians cover the visits that matter most, in one place."
      />
      <a href="/services" class="hidden shrink-0 items-center gap-1.5 font-mono text-xs uppercase tracking-[0.12em] text-ink transition hover:text-gold-dark sm:inline-flex">
        View all services
        <Icon name="arrowright" className="h-3.5 w-3.5" />
      </a>
    </div>

    <div class="mt-12 grid gap-px border border-ink/12 bg-ink/12 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service, i) => (
        <ServiceCard name={service.name} summary={service.summary} icon={service.icon as any} href={`/services#${service.slug}`} index={i + 1} />
      ))}
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-paper-warm py-20 sm:py-24" data-meridian="Why Us">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16 lg:px-8">
      <div>
        <SectionHeading
          eyebrow="Why patients switch to us"
          title="Healthcare that treats you like a person, not an appointment slot"
          description="We built Meridian around the things patients told us were missing everywhere else: time, continuity, and honesty about cost."
        />
        <a href="/about" class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-ink transition hover:text-gold-dark">
          Learn about our approach
          <Icon name="arrowright" className="h-3.5 w-3.5" />
        </a>
      </div>
      <div class="grid gap-px border border-ink/12 bg-ink/12 sm:grid-cols-2" data-reveal-group>
        {VALUES.map((value, i) => (
          <div class="bg-paper p-6">
            <span class="font-mono text-xs text-ink/35">{String(i + 1).padStart(2, "0")}</span>
            <span class="mt-3 flex h-9 w-9 items-center justify-center bg-ink/5 text-verdigris">
              <Icon name={value.icon as any} className="h-[18px] w-[18px]" />
            </span>
            <h3 class="mt-4 font-display text-base font-bold text-ink">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Doctor highlight -->
  <section class="bg-night bg-chart-grid py-20 sm:py-24" data-meridian="Care Team">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16 lg:px-8">
      <div class="duotone duotone-gold aspect-[4/5]" data-reveal>
        <img src={img(IMAGES[leadDoctor.image as keyof typeof IMAGES], 900)} alt={leadDoctor.name} class="h-full w-full object-cover" />
      </div>
      <div data-reveal>
        <Icon name="quote" className="h-9 w-9 text-gold" />
        <p class="mt-4 font-display text-2xl font-medium leading-snug text-paper text-balance sm:text-3xl">
          &ldquo;Our job is not just to treat what&rsquo;s wrong. It&rsquo;s to know you well enough to catch it before it becomes wrong.&rdquo;
        </p>
        <div class="mt-6 border-l-2 border-gold pl-4">
          <p class="font-semibold text-paper">{leadDoctor.name}</p>
          <p class="font-mono text-xs uppercase tracking-wide text-paper/50">{leadDoctor.role}</p>
        </div>
        <a href="/team" class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-paper transition hover:text-gold">
          Meet the full care team
          <Icon name="arrowright" className="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-paper py-20 sm:py-24" data-meridian="Reviews">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <SectionHeading eyebrow="Patient stories" title="Trusted by families across the community" align="center" />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {TESTIMONIALS.slice(0, 3).map((t) => (
          <TestimonialCard name={t.name} context={t.context} quote={t.quote} avatar={t.avatar as any} rating={t.rating} />
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/reviews" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-ink transition hover:text-gold-dark">
          Read more patient reviews
          <Icon name="arrowright" className="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
