---
import Layout from "../layouts/Layout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import { TESTIMONIALS, SITE } from "../lib/site";
---

<Layout
  title={`Patient Reviews | ${SITE.name}`}
  description="What patients say about Meridian Family Health, from same-day urgent visits to long-term chronic care."
>
  <section class="border-b border-ink/10 bg-paper" data-meridian="Reviews">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.05] text-ink text-balance sm:text-6xl">
        What our patients say.
      </h1>
      <p class="mt-6 text-lg text-ink-soft">
        <span class="font-semibold text-ink">4.9 out of 5</span> average across patient reviews.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8" data-meridian="All reviews">
    <div class="grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {TESTIMONIALS.map((t) => (
        <TestimonialCard name={t.name} context={t.context} quote={t.quote} avatar={t.avatar as any} rating={t.rating} />
      ))}
    </div>
    <p class="mt-14 text-sm text-ink-soft">Names, photos and reviews on this page are sample content for the demo.</p>
  </section>

  <CTASection
    title="Book your first visit"
    description="Join the patients who have made Meridian their long-term care home."
  />
</Layout>
