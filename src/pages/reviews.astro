---
import Layout from "../layouts/Layout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon";
import { TESTIMONIALS, SITE } from "../lib/site";
---

<Layout
  title={`Patient Reviews | ${SITE.name}`}
  description="Read what patients say about their experience at Meridian Family Health, from same-day urgent visits to long-term chronic care management."
>
  <!-- Page hero -->
  <section class="bg-paper bg-chart-grid-light" data-meridian="Reviews">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8" data-reveal>
      <p class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-gold-dark">
        <span class="h-px w-4 bg-current"></span>
        Patient reviews
      </p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl font-extrabold text-ink text-balance sm:text-5xl">
        What our patients say.
      </h1>
      <div class="mt-6 flex items-center gap-4 border-t border-ink/10 pt-5">
        <span class="flex items-center gap-1.5 font-mono text-lg text-ink">
          <Icon name="star" className="h-5 w-5 fill-current text-gold" />
          4.9
        </span>
        <span class="h-4 w-px bg-ink/15"></span>
        <span class="font-mono text-xs uppercase tracking-wide text-ink-soft">based on 640+ verified patient reviews</span>
      </div>
    </div>
  </section>

  <!-- Reviews grid -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8" data-meridian="All reviews">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {TESTIMONIALS.map((t) => (
        <TestimonialCard name={t.name} context={t.context} quote={t.quote} avatar={t.avatar as any} rating={t.rating} />
      ))}
    </div>
  </section>

  <CTASection
    title="Add your own story"
    description="Book your first visit and see why patients across the community are making Meridian their long-term care home."
  />
</Layout>
