---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import BookingWidget from "../components/BookingWidget";
import Icon from "../components/Icon";
import { img, IMAGES } from "../lib/images";
import { SITE } from "../lib/site";
---

<Layout
  title={`Contact Us | ${SITE.name}`}
  description="Get in touch with Meridian Family Health, request an appointment, or find our hours, phone number, and location."
>
  <!-- Page hero -->
  <section class="bg-forest-light/60">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-terracotta">Contact</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold text-ink text-balance sm:text-5xl">
        We would love to hear from you.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Have a question, or ready to book? Reach the front desk directly, or send a message below.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- Info column -->
      <div class="space-y-6">
        <div class="rounded-3xl border border-ink/8 bg-paper p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-forest-light text-forest">
            <Icon name="phone" className="h-5 w-5" />
          </span>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink-soft">Call the front desk</p>
          <a href={SITE.phoneHref} class="mt-1 block font-display text-xl text-ink">{SITE.phone}</a>
        </div>

        <div class="rounded-3xl border border-ink/8 bg-paper p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-forest-light text-forest">
            <Icon name="mail" className="h-5 w-5" />
          </span>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink-soft">Email us</p>
          <a href={`mailto:${SITE.email}`} class="mt-1 block font-display text-xl text-ink">{SITE.email}</a>
        </div>

        <div class="rounded-3xl border border-ink/8 bg-paper p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-forest-light text-forest">
            <Icon name="mappin" className="h-5 w-5" />
          </span>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink-soft">Visit the practice</p>
          <p class="mt-1 font-display text-xl text-ink">{SITE.address.line1}</p>
          <p class="text-ink-soft">{SITE.address.line2}</p>
        </div>

        <div class="rounded-3xl border border-ink/8 bg-paper p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-forest-light text-forest">
            <Icon name="clock" className="h-5 w-5" />
          </span>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink-soft">Hours</p>
          <ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
            {SITE.hours.map((h) => (
              <li class="flex justify-between gap-6"><span class="text-ink">{h.day}</span><span>{h.time}</span></li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl bg-forest-dark p-6 text-center">
          <p class="font-display text-lg text-white">Prefer to book directly?</p>
          <div class="mt-4 flex justify-center">
            <BookingWidget client:load label="Book an Appointment" />
          </div>
        </div>
      </div>

      <!-- Form column -->
      <div>
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <!-- Location visual -->
  <section class="relative">
    <div class="aspect-[16/6] w-full overflow-hidden">
      <img
        src={img(IMAGES.reception, 1800)}
        alt={`Reception area at ${SITE.name}`}
        class="h-full w-full object-cover"
      />
    </div>
    <div class="absolute inset-0 flex items-center bg-ink/30">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
        <p class="max-w-md font-display text-2xl text-white text-balance sm:text-3xl">
          Free parking, wheelchair access, and a front desk team that will greet you by name.
        </p>
      </div>
    </div>
  </section>
</Layout>
