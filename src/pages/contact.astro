---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import BookingWidget from "../components/BookingWidget";
import { img, IMAGES } from "../lib/images";
import { SITE } from "../lib/site";
---

<Layout
  title={`Contact Us | ${SITE.name}`}
  description="Contact Meridian Family Health: phone, email, location and opening hours, or request an appointment online."
>
  <section class="border-b border-ink/10 bg-paper" data-meridian="Contact">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
      <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.05] text-ink text-balance sm:text-6xl">
        Contact the practice.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        Call the front desk, send a message, or book a visit online.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8" data-meridian="Get in touch">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div data-reveal>
        <dl class="border-t border-ink/25">
          <div class="border-b border-ink/15 py-5">
            <dt class="text-sm font-semibold text-ink-soft">Call the front desk</dt>
            <dd class="mt-1"><a href={SITE.phoneHref} class="inline-block py-1 font-display text-2xl font-bold text-ink hover:underline">{SITE.phone}</a></dd>
          </div>
          <div class="border-b border-ink/15 py-5">
            <dt class="text-sm font-semibold text-ink-soft">Email</dt>
            <dd class="mt-1"><a href={`mailto:${SITE.email}`} class="inline-block py-1 text-lg font-semibold text-ink hover:underline">{SITE.email}</a></dd>
          </div>
          <div class="border-b border-ink/15 py-5">
            <dt class="text-sm font-semibold text-ink-soft">Visit</dt>
            <dd class="mt-1 text-lg text-ink">{SITE.address.line1}<br />{SITE.address.line2}</dd>
          </div>
          <div class="border-b border-ink/15 py-5">
            <dt class="text-sm font-semibold text-ink-soft">Hours</dt>
            <dd class="mt-2">
              <ul class="space-y-1.5">
                {SITE.hours.map((h) => (
                  <li class="flex justify-between gap-6">
                    <span class="text-ink">{h.day}</span>
                    <span class="text-right text-ink-soft">{h.time}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>

        <div class="mt-8 bg-night p-6" data-tone="dark">
          <p class="font-display text-lg font-bold text-paper">Prefer to book online?</p>
          <div class="mt-4">
            <BookingWidget client:load label="Book an appointment" />
          </div>
        </div>
      </div>

      <div data-reveal>
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <section class="duotone relative" data-tone="dark">
    <div class="aspect-[16/7] min-h-64 w-full">
      <img src={img(IMAGES.reception, 1800)} alt={`The reception area at ${SITE.name}`} class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 z-10 flex items-center">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
        <p class="max-w-md font-display text-2xl font-bold text-paper text-balance sm:text-3xl">
          Free parking and step-free access. The front desk will greet you by name.
        </p>
      </div>
    </div>
  </section>
</Layout>
