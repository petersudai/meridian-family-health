---
import { NAV, SITE } from "../lib/site";
import BookingWidget from "./BookingWidget";
import MobileMenu from "./MobileMenu";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink/5 bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a href="/" class="flex items-center gap-2">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-forest font-display text-base font-semibold text-white">
        M
      </span>
      <span class="font-display text-lg font-semibold text-ink">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-sm font-medium transition hover:text-forest",
            currentPath === item.href ? "text-forest" : "text-ink-soft",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={SITE.phoneHref} class="text-sm font-semibold text-ink transition hover:text-forest">
        {SITE.phone}
      </a>
      <BookingWidget client:load label="Book Now" />
    </div>

    <MobileMenu client:load currentPath={currentPath} />
  </div>
</header>
