---
import { NAV, SITE } from "../lib/site";
import BookingWidget from "./BookingWidget";
import MobileMenu from "./MobileMenu";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink/15 bg-paper">
  <div class="mx-auto flex max-w-7xl items-stretch justify-between gap-6 px-6 lg:px-8">
    <a href="/" class="flex items-baseline gap-2.5 py-4" aria-label={`${SITE.name}, home`}>
      <span class="font-display text-xl font-extrabold uppercase tracking-tight text-ink">{SITE.shortName}</span>
      <span class="hidden text-sm font-medium text-ink-soft sm:inline">Family Health</span>
    </a>

    <nav class="hidden items-stretch gap-6 lg:flex xl:gap-8" aria-label="Main">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? "page" : undefined}
          class:list={[
            "-mb-px flex items-center border-b-2 text-[15px] font-medium transition-colors",
            currentPath === item.href
              ? "border-gold text-ink"
              : "border-transparent text-ink-soft hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 py-2.5 lg:flex">
      <a href={SITE.phoneHref} class="hidden py-2 text-[15px] font-semibold text-ink hover:underline xl:inline">
        {SITE.phone}
      </a>
      <BookingWidget client:load label="Book now" />
    </div>

    <div class="flex items-center py-2.5 lg:hidden">
      <MobileMenu client:load currentPath={currentPath} />
    </div>
  </div>
</header>
