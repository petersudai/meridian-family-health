---
import { NAV, SITE } from "../lib/site";
import BookingWidget from "./BookingWidget";
import MobileMenu from "./MobileMenu";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/92 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a href="/" class="group flex items-baseline gap-2.5">
      <span class="font-display text-xl font-extrabold uppercase tracking-tight text-ink">
        {SITE.shortName}
      </span>
      <span class="hidden font-mono text-[10px] uppercase tracking-[0.2em] text-ink-soft sm:inline">
        Family&nbsp;Health
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-mono text-[11px] uppercase tracking-[0.14em] transition-colors",
            currentPath === item.href ? "text-gold-dark" : "text-ink-soft hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={SITE.phoneHref} class="font-mono text-[11px] tracking-wide text-ink-soft transition-colors hover:text-ink">
        {SITE.phone}
      </a>
      <BookingWidget client:load label="Book Now" />
    </div>

    <MobileMenu client:load currentPath={currentPath} />
  </div>
</header>
