---
import { img, IMAGES } from "../lib/images";

interface Props {
  slug: string;
  name: string;
  role: string;
  bio: string;
  education: string;
  image: keyof typeof IMAGES;
  compact?: boolean;
}

const { name, role, bio, education, image, compact = false } = Astro.props;
---

<article class="group flex flex-col" data-reveal>
  <div class="duotone aspect-[4/5] overflow-hidden">
    <img
      src={img(IMAGES[image], 800)}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-4 border-t border-ink/15 pt-4">
    <h3 class="font-display text-lg font-bold text-ink">{name}</h3>
    <p class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.12em] text-verdigris">{role}</p>
    {!compact && (
      <>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{bio}</p>
        <p class="mt-4 text-xs leading-relaxed text-ink-soft">{education}</p>
      </>
    )}
  </div>
</article>
