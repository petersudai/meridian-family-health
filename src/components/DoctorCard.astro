---
import { img, IMAGES } from "../lib/images";

interface Props {
  name: string;
  role: string;
  bio: string;
  education: string;
  image: keyof typeof IMAGES;
}

const { name, role, bio, education, image } = Astro.props;
---

<article class="group flex flex-col" data-reveal>
  <div class="duotone aspect-[4/5]">
    <img
      src={img(IMAGES[image], 800)}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-4 border-t border-ink/20 pt-4">
    <h3 class="font-display text-xl font-bold text-ink">{name}</h3>
    <p class="mt-0.5 font-semibold text-verdigris-dark">{role}</p>
    <p class="mt-3 text-ink-soft">{bio}</p>
    <p class="mt-3 text-sm text-ink-soft">{education}</p>
  </div>
</article>
