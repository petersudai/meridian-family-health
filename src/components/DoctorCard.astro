---
import { img, IMAGES } from "../lib/images";

interface Props {
  slug: string;
  name: string;
  role: string;
  bio: string;
  education: string;
  image: keyof typeof IMAGES;
  compact?: boolean;
}

const { name, role, bio, education, image, compact = false } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-3xl border border-ink/8 bg-paper transition hover:shadow-xl hover:shadow-forest/5">
  <div class="aspect-[4/5] overflow-hidden bg-forest-light">
    <img
      src={img(IMAGES[image], 800)}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-lg font-semibold text-ink">{name}</h3>
    <p class="mt-0.5 text-sm font-medium text-terracotta">{role}</p>
    {!compact && (
      <>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{bio}</p>
        <p class="mt-4 text-xs leading-relaxed text-ink-soft/70">{education}</p>
      </>
    )}
  </div>
</article>
