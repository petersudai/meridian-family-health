---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
}

const { eyebrow, title, description, align = "left", tone = "dark" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && (
    <p class:list={["text-sm font-semibold uppercase tracking-wider", tone === "dark" ? "text-terracotta" : "text-terracotta-light"]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={["mt-3 font-display text-3xl font-semibold text-balance sm:text-4xl", tone === "dark" ? "text-ink" : "text-white"]}>
    {title}
  </h2>
  {description && (
    <p class:list={["mt-4 text-base leading-relaxed sm:text-lg", tone === "dark" ? "text-ink-soft" : "text-cream/70"]}>
      {description}
    </p>
  )}
</div>
