---
interface Props {
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
}

const { title, description, align = "left", tone = "light" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <h2
    class:list={[
      "font-display text-3xl font-extrabold leading-[1.1] text-balance sm:text-4xl",
      tone === "light" ? "text-ink" : "text-paper",
    ]}
  >
    {title}
  </h2>
  {description && (
    <p class:list={["mt-4 text-lg leading-relaxed", tone === "light" ? "text-ink-soft" : "text-paper/75"]}>
      {description}
    </p>
  )}
</div>
