---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
}

const { eyebrow, title, description, align = "left", tone = "dark" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]} data-reveal>
  {eyebrow && (
    <p
      class:list={[
        "flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em]",
        align === "center" && "justify-center",
        tone === "dark" ? "text-gold-dark" : "text-gold",
      ]}
    >
      <span class="h-px w-4 bg-current"></span>
      {eyebrow}
    </p>
  )}
  <h2
    class:list={[
      "mt-4 font-display text-3xl font-extrabold leading-[1.08] text-balance sm:text-4xl",
      tone === "dark" ? "text-ink" : "text-paper",
    ]}
  >
    {title}
  </h2>
  {description && (
    <p class:list={["mt-4 text-base leading-relaxed sm:text-lg", tone === "dark" ? "text-ink-soft" : "text-paper/65"]}>
      {description}
    </p>
  )}
</div>
