---
import { img, IMAGES } from "../lib/images";
import Icon from "./Icon";

interface Props {
  name: string;
  context: string;
  quote: string;
  avatar: keyof typeof IMAGES;
  rating: number;
}

const { name, context, quote, avatar, rating } = Astro.props;
---

<figure class="flex h-full flex-col rounded-3xl border border-ink/8 bg-paper p-7">
  <Icon name="quote" className="h-7 w-7 text-terracotta/40" />
  <div class="mt-3 flex gap-0.5 text-terracotta">
    {Array.from({ length: rating }).map(() => <Icon name="star" className="h-4 w-4 fill-current" />)}
  </div>
  <blockquote class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">"{quote}"</blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <img src={img(IMAGES[avatar], 160)} alt="" class="h-11 w-11 rounded-full object-cover" loading="lazy" />
    <div>
      <p class="text-sm font-semibold text-ink">{name}</p>
      <p class="text-xs text-ink-soft">{context}</p>
    </div>
  </figcaption>
</figure>
