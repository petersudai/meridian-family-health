---
import { img, IMAGES } from "../lib/images";

interface Props {
  name: string;
  context: string;
  quote: string;
  avatar: keyof typeof IMAGES;
  rating: number;
}

const { name, context, quote, avatar, rating } = Astro.props;
---

<figure class="flex h-full flex-col border-t-2 border-ink pt-5" data-reveal>
  <blockquote class="flex-1 text-lg leading-relaxed text-ink">&ldquo;{quote}&rdquo;</blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <div class="duotone h-11 w-11 flex-shrink-0 overflow-hidden rounded-full">
      <img src={img(IMAGES[avatar], 160)} alt="" class="h-full w-full object-cover" loading="lazy" />
    </div>
    <div>
      <p class="font-semibold text-ink">{name}</p>
      <p class="text-sm text-ink-soft">{context}, rated {rating} out of 5</p>
    </div>
  </figcaption>
</figure>
