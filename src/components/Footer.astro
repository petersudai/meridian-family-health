---
import { NAV, SITE } from "../lib/site";
---

<footer class="border-t border-night-line bg-night text-paper/80">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
    <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="font-display text-2xl font-extrabold uppercase tracking-tight text-paper">
          {SITE.shortName}
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/55">
          Whole-family primary care with same-week appointments, transparent pricing, and doctors who know your name.
        </p>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gold">Explore</p>
        <ul class="mt-5 space-y-3 text-sm">
          {NAV.map((item) => (
            <li><a href={item.href} class="text-paper/65 transition hover:text-paper">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gold">Hours</p>
        <ul class="mt-5 space-y-3.5 text-sm">
          {SITE.hours.map((h) => (
            <li class="border-l border-night-line pl-3">
              <p class="text-paper/70">{h.day}</p>
              <p class="font-mono text-xs text-paper/70">{h.time}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-gold">Visit us</p>
        <address class="mt-5 text-sm leading-relaxed text-paper/65 not-italic">
          {SITE.address.line1}<br />
          {SITE.address.line2}
        </address>
        <div class="mt-4 space-y-1.5 text-sm">
          <a href={SITE.phoneHref} class="block font-mono text-paper transition hover:text-gold">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="block text-paper/65 transition hover:text-paper">{SITE.email}</a>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse gap-4 border-t border-night-line pt-8 font-mono text-[11px] text-paper/65 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p>Design portfolio piece. Not a real medical practice.</p>
    </div>
  </div>
</footer>
