---
import { NAV, SITE } from "../lib/site";
---

<footer class="border-t border-ink/10 bg-forest-dark text-cream/80">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
    <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 font-display text-base font-semibold text-white">
            M
          </span>
          <span class="font-display text-lg font-semibold text-white">{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/60">
          Whole-family primary care with same-week appointments, transparent pricing, and doctors who know your name.
        </p>
      </div>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-cream/50">Explore</p>
        <ul class="mt-5 space-y-3 text-sm">
          {NAV.map((item) => (
            <li><a href={item.href} class="text-cream/70 transition hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-cream/50">Hours</p>
        <ul class="mt-5 space-y-3.5 text-sm">
          {SITE.hours.map((h) => (
            <li>
              <p class="text-cream/70">{h.day}</p>
              <p class="text-cream/45">{h.time}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-cream/50">Visit us</p>
        <address class="mt-5 text-sm leading-relaxed text-cream/70 not-italic">
          {SITE.address.line1}<br />
          {SITE.address.line2}
        </address>
        <div class="mt-4 space-y-1.5 text-sm">
          <a href={SITE.phoneHref} class="block font-semibold text-white transition hover:text-cream">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="block text-cream/70 transition hover:text-white">{SITE.email}</a>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse gap-4 border-t border-white/10 pt-8 text-xs text-cream/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p>Design portfolio piece. Not a real medical practice.</p>
    </div>
  </div>
</footer>
