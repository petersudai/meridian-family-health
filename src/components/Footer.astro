---
import { NAV, SITE } from "../lib/site";
---

<footer class="bg-night text-paper" data-tone="dark">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
    <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block py-1 font-display text-2xl font-extrabold uppercase tracking-tight">
          {SITE.shortName}
        </a>
        <p class="mt-3 max-w-xs text-paper/70">
          Family medicine in Cedar Falls since 2008. Same-week appointments, prices you know in advance, and doctors who know your name.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-paper">Explore</h2>
        <ul class="mt-3">
          {NAV.map((item) => (
            <li><a href={item.href} class="inline-block py-1.5 text-paper/75 transition hover:text-paper hover:underline">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-paper">Hours</h2>
        <ul class="mt-3 space-y-3">
          {SITE.hours.map((h) => (
            <li>
              <p class="text-paper/75">{h.day}</p>
              <p class="text-paper">{h.time}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-paper">Visit us</h2>
        <address class="mt-3 text-paper/75 not-italic">
          {SITE.address.line1}<br />
          {SITE.address.line2}
        </address>
        <p class="mt-3">
          <a href={SITE.phoneHref} class="inline-block py-1 font-semibold text-paper hover:underline">{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`} class="inline-block py-1 text-paper/75 transition hover:text-paper hover:underline">{SITE.email}</a>
        </p>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse gap-3 border-t border-night-line pt-8 text-sm text-paper/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p>A design portfolio piece. Not a real medical practice.</p>
    </div>
  </div>
</footer>
