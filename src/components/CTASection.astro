---
import BookingWidget from "./BookingWidget";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Book your first visit",
  description = "Pick a time online. We confirm by email or phone within one business hour.",
} = Astro.props;
---

<section class="bg-night py-20 sm:py-24" data-meridian="Book" data-tone="dark">
  <div class="mx-auto max-w-3xl px-6 lg:px-8" data-reveal>
    <h2 class="font-display text-3xl font-extrabold text-paper text-balance sm:text-5xl">{title}</h2>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-paper/75">{description}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <BookingWidget client:load label="Book an appointment" />
      <a href="/contact" class="btn btn-secondary-dark">Send a message</a>
    </div>
  </div>
</section>
