---
import BookingWidget from "./BookingWidget";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ready to feel like more than a patient number?",
  description = "Same-week appointments are open now. Tell us what you need and our care team will confirm within one business hour.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-night bg-chart-grid py-20 sm:py-28" data-meridian="Book">
  <div class="relative mx-auto max-w-3xl px-6 text-center lg:px-8" data-reveal>
    <p class="flex items-center justify-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-gold">
      <span class="h-px w-4 bg-current"></span>
      Same-week availability
      <span class="h-px w-4 bg-current"></span>
    </p>
    <h2 class="mt-5 font-display text-3xl font-extrabold text-paper text-balance sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-paper/65 sm:text-lg">{description}</p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <BookingWidget client:load label="Book an Appointment" />
      <a
        href="/contact"
        class="inline-flex items-center justify-center border border-paper/25 px-6 py-3 font-mono text-xs uppercase tracking-[0.12em] text-paper transition hover:border-paper"
      >
        Contact the practice
      </a>
    </div>
  </div>
</section>
