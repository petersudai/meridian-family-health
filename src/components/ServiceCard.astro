---
import Icon, { type IconName } from "./Icon";

interface Props {
  name: string;
  summary: string;
  icon: IconName;
  href?: string;
  index?: number;
}

const { name, summary, icon, href, index } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  data-reveal
  class:list={[
    "group relative flex h-full flex-col justify-between border border-ink/12 bg-paper-warm p-7 transition-colors duration-300 hover:border-ink hover:bg-ink",
    href && "cursor-pointer",
  ]}
>
  <div>
    <div class="flex items-center justify-between">
      {index !== undefined && (
        <span class="font-mono text-xs text-ink/35 transition-colors duration-300 group-hover:text-paper/40">
          {String(index).padStart(2, "0")}
        </span>
      )}
      <Icon name={icon} className="h-5 w-5 text-verdigris transition-colors duration-300 group-hover:text-gold" />
    </div>
    <h3 class="mt-6 font-display text-xl font-bold text-ink transition-colors duration-300 group-hover:text-paper">
      {name}
    </h3>
    <p class="mt-2.5 text-sm leading-relaxed text-ink-soft transition-colors duration-300 group-hover:text-paper/70">
      {summary}
    </p>
  </div>
  {href && (
    <span class="mt-6 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-ink/45 transition-colors duration-300 group-hover:text-gold">
      Learn more
      <Icon name="arrowright" className="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  )}
</Tag>
